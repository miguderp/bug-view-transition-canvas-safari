---
import WebGL_three from "../components/WebGL_three.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<div class="grid place-items-center h-dvh">
		<div class="grid gap-4 text-center">
			<p id="target" style="view-transition-name: target;">
				Some random element
			</p>

			<button
				id="btn"
				class="px-4 py-3 bg-amber-50 text-black cursor-pointer select-none"
			>
				Click this to toggle above
			</button>

			<WebGL_three />

			<p>
				Safari (only) has a visual glitch, making the Canvas disappear
				for one frame.<br />
				Repository with code <a
					href="https://github.com/miguderp/bug-view-transition-canvas-safari"
					target="_blank"
					rel="noopener noreferrer"
					class="underline underline-offset-4"
				>
					available here
				</a>.
			</p>
		</div>
	</div>
</Layout>

<script>
	const btn = document.getElementById("btn");
	const target = document.getElementById("target");
	btn!.addEventListener("click", () => {
		if (document.startViewTransition) {
			document.startViewTransition(() => {
				target?.classList.toggle("text-red-500");
			});
		} else {
			console.log("View transition not supported");
		}
	});
</script>
